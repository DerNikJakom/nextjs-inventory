generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model geraete {
  mitarbeiter_id     Int
  name               String      @db.VarChar(50)
  hersteller         String?     @db.VarChar(50)
  modell             String?     @db.VarChar(50)
  produktnummer      String?     @db.VarChar(50)
  seriennummer       String?     @db.VarChar(50)
  code               String      @db.Char(6) @unique
  geraetetyp         String?     @db.VarChar(50)
  anschaffungsdatum  String?     @db.Char(10)
  anschaffungskosten String?     @db.VarChar(10)
  standort           String?     @db.VarChar(30)
  bemerkungen        String?     @db.VarChar(100)
  mitarbeiter        mitarbeiter @relation(fields: [mitarbeiter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "geraete_mitarbeiter_id_fk")

  @@id([mitarbeiter_id, code], map: "geraete_pk")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model logs {
  id             Int?
  timestamp      String? @db.VarChar(50)
  executedUser   Int?
  affectedDevice Int?
  oldUser        Int?
  newUser        Int?
  message        String? @db.VarChar(100)

  @@ignore
}

model mitarbeiter {
  id       Int       @id(map: "mitarbeiter_pk") @default(autoincrement())
  vorname  String?   @db.VarChar(50)
  nachname String?   @db.VarChar(50)
  email    String?   @db.VarChar(50)
  passwort String?   @db.VarChar(100)
  salt     String?   @db.VarChar(100)
  rolle    String?   @db.VarChar(50)
  geraete  geraete[]
}
